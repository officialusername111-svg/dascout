# Copy to .env.local and fill in the key.
# Supabase dashboard -> Project Settings -> API keys
#
# Both values below are PUBLIC — they are compiled into the browser bundle and
# are safe there, because row-level security is what actually protects the data.
# The service_role key must never appear in this file.

NEXT_PUBLIC_SUPABASE_URL=https://kogpuuidawbmttyswvsx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Test fixture accounts for the Phase 4 admin test suite (values live only in .env.local;
# rotate or delete the accounts after review -- see docs/agent-runs/run-p4-admin.md)
TEST_STAFF_EMAIL=
TEST_STAFF_PASSWORD=
TEST_BUYER_EMAIL=
TEST_BUYER_PASSWORD=
